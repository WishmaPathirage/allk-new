rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ══════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ══════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@al.lk';
    }

    function isTeacher() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/teachers/$(request.auth.uid));
    }

    function isTeacherWithId(teacherId) {
      return isTeacher() &&
        firestore.get(/databases/(default)/documents/teachers/$(request.auth.uid)).data.id == teacherId;
    }

    // File type validators
    function isImageType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp)');
    }

    function isDocType() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd\\..*') ||
             request.resource.contentType.matches('image/(jpeg|jpg|png|gif|webp)') ||
             request.resource.contentType.matches('video/(mp4|webm|ogg)');
    }

    function isPaymentSlipType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') ||
             request.resource.contentType.matches('application/pdf');
    }

    // Size validators (megabytes)
    function maxMB(mb) {
      return request.resource.size <= mb * 1024 * 1024;
    }

    // ══════════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ══════════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // PAYMENT SLIPS — registration
    // Write: any signed-in user (max 10 MB, images/PDF only)
    // Read:  any signed-in user | admin
    // Delete/Overwrite: admin only
    // ══════════════════════════════════════════════════════════════
    match /payment-slips/{filename} {
      // Public read — upload is already unauthenticated; filenames are timestamp-obscured
      allow read: if true;

      // Public (no auth) — registration form submits before student has an account
      allow create: if maxMB(10) && isPaymentSlipType();

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════
    // MONTHLY PAYMENT SLIPS
    // ══════════════════════════════════════════════════════════════
    match /monthly-payments/{filename} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        maxMB(10) &&
        isPaymentSlipType();

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════
    // STUDY MATERIALS — teacher uploads, students read
    // Path: /study-materials/{teacherId}/...
    // ══════════════════════════════════════════════════════════════
    match /study-materials/{teacherId}/{allPaths=**} {
      allow read: if isSignedIn();

      allow create: if (isAdmin() || isTeacherWithId(teacherId)) &&
        maxMB(50) &&
        isDocType();

      allow update: if isAdmin() || isTeacherWithId(teacherId);
      allow delete: if isAdmin() || isTeacherWithId(teacherId);
    }

    // ══════════════════════════════════════════════════════════════
    // EXAM PAPERS — teacher/admin uploads PDF papers, students read
    // Path: /exam-papers/{teacherId}/...
    // ══════════════════════════════════════════════════════════════
    match /exam-papers/{teacherId}/{allPaths=**} {
      allow read: if isSignedIn();

      allow create: if (isAdmin() || isTeacherWithId(teacherId)) &&
        maxMB(50) &&
        isDocType();

      allow update: if isAdmin() || isTeacherWithId(teacherId);
      allow delete: if isAdmin() || isTeacherWithId(teacherId);
    }

    // ══════════════════════════════════════════════════════════════
    // RECORDS / PAST PAPERS
    // Path: /records/{teacherId}/...
    // ══════════════════════════════════════════════════════════════
    match /records/{teacherId}/{allPaths=**} {
      allow read: if isSignedIn();

      allow create: if isTeacherWithId(teacherId) &&
        maxMB(50) &&
        isDocType();

      allow update: if isAdmin() || isTeacherWithId(teacherId);
      allow delete: if isAdmin() || isTeacherWithId(teacherId);
    }

    // ══════════════════════════════════════════════════════════════
    // FOLDER THUMBNAILS
    // ══════════════════════════════════════════════════════════════
    match /folder-thumbnails/{type}/{filename} {
      allow read: if isSignedIn();

      allow create: if (isTeacher() || isAdmin()) &&
        maxMB(5) &&
        isImageType();

      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }

    // ══════════════════════════════════════════════════════════════
    // PROFILE PHOTOS — student uploads their own photo
    // Path: /profile-photos/{studentId}
    // ══════════════════════════════════════════════════════════════
    match /profile-photos/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && maxMB(5) && isImageType();
    }

    // ══════════════════════════════════════════════════════════════
    // HERO VIDEO — public read, admin-only write
    // ══════════════════════════════════════════════════════════════
    match /hero-video/{filename} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
